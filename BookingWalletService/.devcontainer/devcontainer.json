{
  "name": "Java + Maven Dev",
  "image": "maven:3.9-eclipse-temurin-21",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ],
      "settings": {
        "java.home": "/opt/java/openjdk",
        "maven.executable.path": "/usr/share/maven/bin/mvn"
      }
    }
  },

  "remoteUser": "root"
}